+const char *edgeName(SdAutomounterEdge edge)
+{
+    switch(edge)
+    {
+        case SdAutomounterEdge::None:     return "none";
+        case SdAutomounterEdge::Inserted: return "inserted";
+        case SdAutomounterEdge::Removed:  return "removed";
+    }
+    return "unknown";
+}
