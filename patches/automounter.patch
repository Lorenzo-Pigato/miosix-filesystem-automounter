+bool askYesNo(const char *prompt)
+{
+    iprintf("%s [y/N] ", prompt);
+    for(;;)
+    {
+        int c = getchar();
+        if(c == '\n') continue;
+        return c == 'y' || c == 'Y';
+    }
+}
+
+void waitForAck(const char *prompt)
+{
+    iprintf("%s Type 'y' when done. ", prompt);
+    for(;;)
+    {
+        int c = getchar();
+        if(c == '\n') continue;
+        if(c == 'y' || c == 'Y') return;
+    }
+}
