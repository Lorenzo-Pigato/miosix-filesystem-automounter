+[[noreturn]] void fail(const char *cause)
+{
+    // Avoid stack-heavy printing here because some test threads are small.
+    write(STDOUT_FILENO, "Failed:\n", 8);
+    write(STDOUT_FILENO, cause, strlen(cause));
+    write(STDOUT_FILENO, "\n", 1);
+    reboot();
+    for(;;) ;
+}
