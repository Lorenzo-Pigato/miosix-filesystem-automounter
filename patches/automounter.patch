+bool checkAvailHeap(unsigned int minimum)
+{
+    unsigned int free = MemoryProfiling::getCurrentFreeHeap();
+    if(free < minimum)
+    {
+        iprintf("Skipping, low heap (%u<%u).\n", free, minimum);
+        return false;
